# type-checks the generated examples with a given TypeScript version: make test-matrix
FROM node:alpine
ARG TS_VER=latest

WORKDIR /app
RUN npm install --no-fund --no-audit typescript@${TS_VER}

COPY examples ./examples
CMD ["sh", "-c", "npx tsc --version && npx tsc --noEmit --strict --target es2022 --module nodenext --lib es2022,dom examples/*.ts"]
