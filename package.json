{
  "type": "module",
  "name": "apigen-ts",
  "version": "1.5.1",
  "license": "MIT",
  "author": "vladkens <v.pronsky@gmail.com>",
  "repository": "vladkens/apigen-ts",
  "description": "Generate a typed TypeScript client from OpenAPI or Swagger in one file: a method per endpoint, plain fetch, no runtime dependencies.",
  "keywords": [
    "openapi",
    "swagger",
    "typescript",
    "api-client",
    "client",
    "sdk",
    "fetch",
    "generator",
    "codegen",
    "openapi3",
    "swagger2"
  ],
  "scripts": {
    "build": "rm -rf dist && pkgroll && cp ./src/_template.ts ./dist && ls -lah dist",
    "test": "tsx --test test/*.test.ts",
    "test-cov": "tsx --experimental-test-coverage --test test/*.test.ts",
    "format": "prettier --write --log-level warn ."
  },
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@redocly/openapi-core": "2.76.0",
    "@types/lodash-es": "4.17.12",
    "@types/swagger2openapi": "7.0.4",
    "array-utils-ts": "1.1.0",
    "cleye": "2.7.0",
    "lodash-es": "4.18.1",
    "swagger2openapi": "7.0.8",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fetch-mock": "12.6.0",
    "npm-check-updates": "23.1.1",
    "pkgroll": "2.29.0",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "tsx": "4.23.15"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/main.js",
  "types": "./dist/main.d.cts",
  "exports": {
    "require": {
      "types": "./dist/main.d.cts",
      "default": "./dist/main.cjs"
    },
    "import": {
      "types": "./dist/main.d.mts",
      "default": "./dist/main.mjs"
    }
  },
  "bin": {
    "apigen-ts": "./dist/cli.js"
  }
}
